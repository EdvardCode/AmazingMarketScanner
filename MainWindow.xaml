<Window x:Class="com.edvardcode.AmazingMarketScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Amazing Market Scanner" Width="1280" Height="840"
        WindowStartupLocation="CenterScreen" Background="#121212" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FACC15"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B8B8B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="CaretBrush" Value="#FACC15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FACC15"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TinyButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A1515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DgHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="#FACC15"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="DgCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="#FACC15"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА -->
        <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="AMAZING MARKET SCANNER" Foreground="#F5F5F5" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="лучшая цена продажи по 40 павильонам" Style="{StaticResource Dim}" Margin="0,2,0,10"/>
                    <WrapPanel>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="ChipScan"    Text="…" Foreground="#4ADE80" FontSize="11"/>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="ChipClosed"  Text="…" Foreground="#F87171" FontSize="11"/>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="ChipResults" Text="…" Foreground="#FACC15" FontSize="11"/>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="ChipReset"   Text="…" Foreground="#9CA3AF" FontSize="11"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="ЧТО ПРОДАЁМ" Style="{StaticResource H2}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetInput" Style="{StaticResource DarkTextBox}" KeyDown="TargetInput_KeyDown"/>
                        <Button Grid.Column="2" Content="Добавить" Style="{StaticResource RoundButton}" Click="AddTarget_Click"/>
                    </Grid>
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <ItemsControl x:Name="TargetsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#242424" CornerRadius="8" Padding="10,5" Margin="0,0,0,4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Tag="{Binding}"
                                                    Style="{StaticResource TinyButton}" Click="RemoveTarget_Click"/>
                                            <TextBlock Text="{Binding}" Foreground="#F5F5F5" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="ПАВИЛЬОНЫ" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="ProgressText" Text="0 / 40" Foreground="#8B8B8B" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="40" Value="0"
                                 Background="#2A2A2A" Foreground="#FACC15" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="PavilionGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="58" Height="48" Margin="3" CornerRadius="10"
                                        Background="{Binding TileBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="2">
                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="16" FontWeight="Bold" Foreground="{Binding NumberBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ПРАВАЯ КОЛОНКА -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ТЕКУЩИЙ ПАВИЛЬОН" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="CurrentNumberText" Text="1" Foreground="#F5F5F5" FontSize="42" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="откройте в игре окно «Продать» и нажмите хоткей скана&#10;если павильон закрыт — хоткей «закрыт»"
                                   Foreground="#9CA3AF" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="4" Background="#000000" CornerRadius="8" ClipToBounds="True">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Panel}">
                <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#2A2A2A" RowBackground="#1B1B1B"
                          AlternatingRowBackground="#212121" Foreground="#F5F5F5"
                          RowHeight="30" CanUserAddRows="False"
                          ColumnHeaderStyle="{StaticResource DgHeader}" CellStyle="{StaticResource DgCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding Item}" Width="2*"/>
                        <DataGridTextColumn Header="Лучшая цена" Binding="{Binding BestPrice, StringFormat={}{0:N0} ₽}" Width="*"/>
                        <DataGridTextColumn Header="Павильон" Binding="{Binding PavilionDisplay}" Width="80"/>
                        <DataGridTextColumn Header="Средняя" Binding="{Binding AvgPrice, StringFormat={}{0:N0}}" Width="*"/>
                        <DataGridTextColumn Header="Выгода" Binding="{Binding GainVsAvg, StringFormat={}{0:N0}}" Width="*"/>
                        <DataGridTextColumn Header="Шт." Binding="{Binding OfferCount}" Width="50"/>
                        <DataGridTextColumn Header="Все цены (по убыванию)" Binding="{Binding AllPrices}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0">
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                         Foreground="#9CA3AF" FontFamily="Consolas" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>